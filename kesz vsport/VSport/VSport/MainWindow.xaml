<Window x:Class="VSport.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="vSport Pro - Belépés" Height="650" Width="1000" Background="#0F0F0F"
        WindowStartupLocation="CenterScreen">



    <!-- ez a resz ket stílust definial:
    Card altalanos kartya-stilus, lekerekitett sarkokkal,
    arnyekkal, hatterrel es hatarolo-val, BetBox a Card-ra epulo stilus fogadasi
    mezoknek, fix magassaggal, kez kurzorral, es eger folotti animacioval:
    vilagosabb hatter, kek keret es kicsit nagyobb meret ha az eger fele viszik;-->
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="BorderBrush" Value="#2E2E2E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" Color="#000000" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BetBox" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Height" Value="100"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#202020"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2B2B2B"/>
                    <Setter Property="BorderBrush" Value="#0078D7"/>
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1.03" ScaleY="1.03"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>



        <!-- ez a resz egy Storyboard-ot hoz letre GoalFlash nevvel:
        a cel a Border hatter szinenek animalasa; a szin zold (#00FF3C)-rol
        sötetszurke (#252525)-re valt egy masodperc alatt, visszafele nem automatikusan.-->
        <Storyboard x:Key="GoalFlash">
            <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                            From="#00FF3C" To="#252525" Duration="0:0:1" AutoReverse="False"/>
        </Storyboard>
    </Window.Resources>

    <!-- fo tartalom (egymásra rakott racs, hogy a login panel elfedhesse a jatekot) -->
    
    
    
    <Grid>

        <!-- fo jatek panel (hatul) -->
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            
            <!-- felhasznalo panel -->
            <Border Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource Card}">
                <!-- Ez a sor egy Border elemet hoz letre,
                ami a 0. sorban van, ket oszlopot foglal el, es a Card stilust alkalmazza rajta a megadott Window.Resources-bol.
                A stilus ad neki lekerekitett sarkokat, paddingot, hatterszint, keretet es enyhe drop shadow-t.-->
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="55" Height="55" Fill="#0078D7" Stroke="#0090FF" StrokeThickness="2"/>
                    <StackPanel Margin="15,0" VerticalAlignment="Center">
                        <TextBlock x:Name="FelhasznaloNevSzoveg" Text="Üdvözöljük, Játékos!" Foreground="White" FontSize="20" FontWeight="Bold"/>
                        <TextBlock x:Name="EgyenlegSzoveg" Text="Egyenleg: 0 Ft" Foreground="#1ED760" FontSize="16"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            
            <!-- merkozes panel -->
            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Következő mérkőzés" Foreground="#BBBBBB" FontSize="14" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="HazaiCsapatNev" Text="HAZAI" Foreground="White" FontSize="22" FontWeight="Bold" Width="140" TextAlignment="Right" TextWrapping="Wrap"/>
                        <Border x:Name="EredmenyBorder" CornerRadius="14" Padding="25,10" Margin="15,0">
                            <Border.Background>
                                <SolidColorBrush Color="#252525"/>
                            </Border.Background>
                            <TextBlock x:Name="EredmenySzoveg" Text="0 : 0" Foreground="#1E90FF" FontSize="50" FontWeight="Black"/>
                        </Border>
                        <TextBlock x:Name="VendegCsapatNev" Text="VENDÉG" Foreground="White" FontSize="22" FontWeight="Bold" Width="140" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock x:Name="StatuszSzoveg" Text="Várakozás a mérkőzésre..." Grid.Row="2" Foreground="#777" Margin="0,10" HorizontalAlignment="Center"/>
                </Grid>
            </Border>

            
            <!-- fogadasi opciok taroloja -->
            <UniformGrid x:Name="FogadasPanel" Grid.Row="2" Grid.Column="0" Columns="3">
                <!-- egy olyan konténer, ami a gyerekeit egyenlő
                méretű cellákba rendezi automatikusan, sorok
                és oszlopok szerint, így minden elem ugyanolyan szélességű és magas lesz-->
                <Border Style="{StaticResource BetBox}">
                    <StackPanel VerticalAlignment="Center">
                        <CheckBox x:Name="Chk1" Content="Hazai (1)" Foreground="White" FontSize="17" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="Szorzo1" Text="1.00" Foreground="#1E90FF" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource BetBox}">
                    <StackPanel VerticalAlignment="Center">
                        <CheckBox x:Name="ChkX" Content="Döntetlen (X)" Foreground="White" FontSize="17" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="SzorzoX" Text="1.00" Foreground="#1E90FF" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource BetBox}">
                    <StackPanel VerticalAlignment="Center">
                        <CheckBox x:Name="Chk2" Content="Vendég (2)" Foreground="White" FontSize="17" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="Szorzo2" Text="1.00" Foreground="#1E90FF" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource BetBox}">
                    <StackPanel VerticalAlignment="Center">
                        <CheckBox x:Name="ChkOver" Content="2.5 Gól Felett" Foreground="White" FontSize="15" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="SzorzoOver" Text="1.00" Foreground="#1E90FF" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource BetBox}">
                    <StackPanel VerticalAlignment="Center">
                        <CheckBox x:Name="ChkSerules" Content="Lesérülés" Foreground="White" FontSize="15" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="SzorzoSerules" Text="1.00" Foreground="#1E90FF" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource BetBox}">
                    <StackPanel VerticalAlignment="Center">
                        <CheckBox x:Name="ChkBefuto" Content="Pályára befutó" Foreground="White" FontSize="15" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="SzorzoBefuto" Text="1.00" Foreground="#FFD700" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            
            <!-- fogadasi szelveny -->
            <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Fogadási szelvény" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>
                    <StackPanel Grid.Row="1">
                        <TextBlock Text="Tét (Ft)" Foreground="Gray" FontSize="13"/>
                        <TextBox x:Name="TetInput" Text="1000" Background="#222" Foreground="White" Padding="10" FontSize="18" BorderThickness="0" Margin="0,5,0,15" RenderTransformOrigin="0.5,0.5">
                            <TextBox.RenderTransform>
                                <TranslateTransform x:Name="TetTransform"/>
                                <!-- textBox-hoz hozzarendelsz egy TranslateTransform-ot,
                                ami lehetove teszi, hogy a TextBox-ot elmozditsd vizszintesen
                                vagy fuggolegesen (X es Y ertekekkel) animacio vagy kod segitsegevel.
                                A x:Name="TetTransform" miatt a kodon belul is el tudod erni ezt a transformot.-->
                            </TextBox.RenderTransform>
                        </TextBox>
                    </StackPanel>
                    <ListBox x:Name="EsemenyLog" Grid.Row="2" Background="#161616" Foreground="#A0A0A0" BorderThickness="0" Padding="5" FontSize="12">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,3"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Grid.Row="3" Content="MÉRKŐZÉS INDÍTÁSA" Height="55" Background="#0078D7" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="JatekInditasa_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="12"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        
        
        <!-- bejelentkezesi overlay -->
        <Grid x:Name="LoginOverlay" Background="#E50A0A0A" Visibility="Visible">
            <Border Style="{StaticResource Card}" Width="450" Height="380" VerticalAlignment="Center" HorizontalAlignment="Center" Background="#161616" Padding="40" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="LoginPanelTransform"/>
                </Border.RenderTransform>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="VSPORT PRO BEJELENTKEZÉS" Foreground="White" FontSize="22" FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                    <TextBlock Text="Játékos neve:" Foreground="Gray" FontSize="14" Margin="0,0,0,5"/>
                    <TextBox x:Name="LoginNevInput" Background="#252525" Foreground="White" FontSize="18" Padding="10" BorderThickness="0" Margin="0,0,0,20"/>

                    <TextBlock Text="Kezdő egyenleg feltöltése (Ft):" Foreground="Gray" FontSize="14" Margin="0,0,0,5"/>
                    <TextBox x:Name="LoginPenzInput" Text="20000" Background="#252525" Foreground="#1ED760" FontWeight="Bold" FontSize="18" Padding="10" BorderThickness="0" Margin="0,0,0,30"/>

                    <Button Content="BELÉPÉS ÉS FELTÖLTÉS" Height="50" Background="#0078D7" Foreground="White" FontWeight="Bold" FontSize="16" Cursor="Hand" Click="Belepes_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>
